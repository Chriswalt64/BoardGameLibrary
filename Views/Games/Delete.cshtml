@model BoardGame
@{
    ViewData["Title"] = "Delete Game";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger" role="alert">
    <h4 class="alert-heading">Are you sure you want to delete this game?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <dl class="row">
            @if (!string.IsNullOrEmpty(Model.Publisher))
            {
                <dt class="col-sm-3">Publisher</dt>
                <dd class="col-sm-9">@Model.Publisher</dd>
            }
            @if (Model.YearPublished.HasValue)
            {
                <dt class="col-sm-3">Year Published</dt>
                <dd class="col-sm-9">@Model.YearPublished</dd>
            }
            @if (Model.MinPlayers.HasValue && Model.MaxPlayers.HasValue)
            {
                <dt class="col-sm-3">Players</dt>
                <dd class="col-sm-9">@Model.MinPlayers - @Model.MaxPlayers</dd>
            }
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
