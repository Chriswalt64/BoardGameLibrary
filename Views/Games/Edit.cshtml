@model BoardGame
@{
    ViewData["Title"] = "Edit Game";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Publisher" class="form-label"></label>
                <input asp-for="Publisher" class="form-control" />
                <span asp-validation-for="Publisher" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="YearPublished" class="form-label"></label>
                    <input asp-for="YearPublished" class="form-control" type="number" />
                    <span asp-validation-for="YearPublished" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="MinPlayers" class="form-label"></label>
                    <input asp-for="MinPlayers" class="form-control" type="number" />
                    <span asp-validation-for="MinPlayers" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="MaxPlayers" class="form-label"></label>
                    <input asp-for="MaxPlayers" class="form-control" type="number" />
                    <span asp-validation-for="MaxPlayers" class="text-danger"></span>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PlayingTimeMinutes" class="form-label"></label>
                    <input asp-for="PlayingTimeMinutes" class="form-control" type="number" />
                    <span asp-validation-for="PlayingTimeMinutes" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Complexity" class="form-label"></label>
                    <select asp-for="Complexity" class="form-select">
                        <option value="">Select...</option>
                        <option value="Light">Light</option>
                        <option value="Medium-Light">Medium-Light</option>
                        <option value="Medium">Medium</option>
                        <option value="Medium-Heavy">Medium-Heavy</option>
                        <option value="Heavy">Heavy</option>
                    </select>
                    <span asp-validation-for="Complexity" class="text-danger"></span>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
