@model BoardGame
@{
    ViewData["Title"] = "Game Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Title</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Publisher))
                {
                    <p><strong>Publisher:</strong> @Model.Publisher</p>
                }
                @if (Model.YearPublished.HasValue)
                {
                    <p><strong>Year Published:</strong> @Model.YearPublished</p>
                }
                @if (Model.MinPlayers.HasValue && Model.MaxPlayers.HasValue)
                {
                    <p><strong>Players:</strong> @Model.MinPlayers - @Model.MaxPlayers</p>
                }
            </div>
            <div class="col-md-6">
                @if (Model.PlayingTimeMinutes.HasValue)
                {
                    <p><strong>Playing Time:</strong> @Model.PlayingTimeMinutes minutes</p>
                }
                @if (!string.IsNullOrEmpty(Model.Complexity))
                {
                    <p><strong>Complexity:</strong> @Model.Complexity</p>
                }
                <p><strong>Date Added:</strong> @Model.DateAdded.ToLocalTime().ToString("MMM dd, yyyy")</p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <hr />
            <p><strong>Description:</strong></p>
            <p>@Model.Description</p>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Loan History</h5>
        <a asp-controller="Loans" asp-action="Create" asp-route-gameId="@Model.Id" class="btn btn-sm btn-success">Lend This Game</a>
    </div>
    <div class="card-body">
        @if (!Model.Loans.Any())
        {
            <p class="text-muted">This game has never been loaned out.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Borrower</th>
                            <th>Loan Date</th>
                            <th>Due Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.Loans.OrderByDescending(l => l.LoanDate))
                        {
                            <tr>
                                <td>@loan.Borrower?.FullName</td>
                                <td>@loan.LoanDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                <td>@(loan.DueDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "N/A")</td>
                                <td>@(loan.ReturnDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>
                                    @if (loan.IsReturned)
                                    {
                                        <span class="badge bg-success">Returned</span>
                                    }
                                    else if (loan.DueDate.HasValue && loan.DueDate < DateTime.UtcNow)
                                    {
                                        <span class="badge bg-danger">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">On Loan</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
